# Copy to .env at the repo root for running Cloudflare and admin commands from your machine.
# Never commit .env. Load it into your shell with: set -a; source .env; set +a
# (Wrangler also reads CLOUDFLARE_* from a .env in the directory it runs in.)

# Wrangler and the cf CLI: an API token for the RelayRunner Cloudflare account, and that account's
# ID. Needed for remote D1 migrations, deploys by hand, and Secrets Store commands. The GitHub
# workflows read the same names from repository secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# A Cloudflare Access service token, for agents and scripts that reach dashboard previews and the
# operator /admin views. Send them as the CF-Access-Client-Id and CF-Access-Client-Secret headers.
# See docs/cloudflare-access.md.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
