{
  "name": "@relayrunner/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute relayrunner --local --file scripts/rename-legacy-migrations.sql && wrangler d1 migrations apply relayrunner --local",
    "db:migrate:remote": "wrangler d1 execute relayrunner --remote --file scripts/rename-legacy-migrations.sql && wrangler d1 migrations apply relayrunner --remote"
  },
  "dependencies": {
    "@relayrunner/access": "workspace:*",
    "@relayrunner/activity": "workspace:*",
    "@relayrunner/email": "workspace:*",
    "@relayrunner/github-webhooks": "workspace:*",
    "@relayrunner/lint-runner": "workspace:*",
    "@relayrunner/machine-protocol": "workspace:*",
    "@relayrunner/runner-order": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
