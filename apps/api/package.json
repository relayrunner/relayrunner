{
  "name": "@relayrunner/api",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute relayrunner --local --file scripts/rename-legacy-migrations.sql && wrangler d1 migrations apply relayrunner --local",
    "db:migrate:remote": "cf d1 migrations apply e6f4f176-aa75-45fe-83f7-64e468cc23f6",
    "db:migrations:remote": "cf d1 migrations list e6f4f176-aa75-45fe-83f7-64e468cc23f6"
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.16",
    "@better-auth/oauth-provider": "^1.7.16",
    "@relayrunner/access": "workspace:*",
    "@relayrunner/activity": "workspace:*",
    "@relayrunner/email": "workspace:*",
    "@relayrunner/errors": "workspace:*",
    "@relayrunner/github-webhooks": "workspace:*",
    "@relayrunner/lint-runner": "workspace:*",
    "@relayrunner/machine-protocol": "workspace:*",
    "@relayrunner/providers": "workspace:*",
    "@relayrunner/runner-order": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "cf": "1.0.0-rc.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
