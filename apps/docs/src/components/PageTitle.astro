---
/* Page title with the frontmatter `description` as a muted one-line summary under it. */
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="summary">{description}</p>}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--sl-color-white);
  }
  .summary {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
</style>
