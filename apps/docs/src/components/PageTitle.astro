---
/*
 * Page title, the frontmatter `description` as a muted summary, and a row of links to the page's
 * agent-readable versions (src/lib/agent-docs.ts): copy as Markdown, view the .md, view the .txt.
 */
const { entry } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const showLinks = entry.id !== "404";
const md = `${base}/${entry.id}.md`;
const txt = `${base}/${entry.id}.txt`;
---

<h1 id="_top">{title}</h1>
{description && <p class="summary">{description}</p>}
{
  showLinks && (
    <div class="page-actions">
      <button type="button" class="action" data-copy-md={md}>
        <svg class="icon icon-copy" viewBox="0 0 24 24" aria-hidden="true">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
        </svg>
        <svg class="icon icon-check" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span class="label">Copy page</span>
      </button>
      <a class="action" href={md}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
          <path d="M14 2v4a2 2 0 0 0 2 2h4" />
          <path d="M16 13H8" />
          <path d="M16 17H8" />
          <path d="M10 9H8" />
        </svg>
        View as Markdown
      </a>
      <a class="action" href={txt}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 8V4H8" />
          <rect width="16" height="12" x="4" y="8" rx="2" />
          <path d="M2 14h2" />
          <path d="M20 14h2" />
          <path d="M15 13v2" />
          <path d="M9 13v2" />
        </svg>
        For AI agents
      </a>
    </div>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-md]")) {
    const label = button.querySelector(".label")!;
    button.addEventListener("click", async () => {
      try {
        const res = await fetch(button.dataset.copyMd!);
        await navigator.clipboard.writeText(await res.text());
        button.dataset.copied = "";
        label.textContent = "Copied";
      } catch {
        label.textContent = "Couldn't copy";
      }
      setTimeout(() => {
        delete button.dataset.copied;
        label.textContent = "Copy page";
      }, 2000);
    });
  }
</script>

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--sl-color-white);
  }
  .summary {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    cursor: pointer;
  }
  .action:hover {
    color: var(--sl-color-white);
  }
  .action:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 3px;
  }
  .icon {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-check,
  .action[data-copied] .icon-copy {
    display: none;
  }
  .action[data-copied] {
    color: var(--sl-color-text-accent);
  }
  .action[data-copied] .icon-check {
    display: inline;
  }
</style>
