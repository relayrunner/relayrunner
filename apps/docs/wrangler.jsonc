{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Docs site: static assets only, like the landing page. There is no `main`, so no Worker script
  // runs and requests never bill as Worker invocations. Temporary home until the docs move into
  // the landing site at relayrunner.app/docs; delete this Worker then.
  "name": "relayrunner-docs",
  "compatibility_date": "2026-11-03",
  // The RelayRunner Cloudflare account (separate from Atticus's personal account).
  "account_id": "b233b6d6fd9eae9e093651bfb043c119",
  "assets": {
    // Pages live in dist/docs/; dist/_redirects sends / to /docs/.
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    // Serves dist/docs/404.html (Starlight's not-found page) for unknown /docs/* paths.
    "not_found_handling": "404-page",
  },
  // No custom domain yet: production is relayrunner-docs.relayrun.workers.dev.
  "workers_dev": true,
  // Branch preview builds (`wrangler versions upload` in Workers Builds) get public preview URLs:
  // <branch>-relayrunner-docs.relayrun.workers.dev. Docs are public, so no Access app.
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
}
