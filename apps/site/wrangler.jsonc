{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Landing page and docs (/docs): one Astro build served as static assets. The Worker script only
  // runs for /docs/* (run_worker_first), to send Markdown to agents that ask for it with
  // `Accept: text/markdown`; every other request is served from assets without invoking it.
  "name": "relayrunner-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-03",
  // The RelayRunner Cloudflare account (separate from Atticus's personal account).
  "account_id": "b233b6d6fd9eae9e093651bfb043c119",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/docs/*"],
    "html_handling": "drop-trailing-slash",
    // Serves dist/404.html (Starlight's not-found page) for unknown paths, landing or docs.
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  // PR preview builds (`wrangler preview` in Workers Builds) get public preview URLs.
  "preview_urls": true,
  // `wrangler preview` (branch preview builds) refuses to run without a previews block; it can be
  // empty because assets and compatibility settings stay at the top level.
  "previews": {},
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
  // Apex of the interim domain. relayrunner.app's MX/TXT records (Email Routing, and DMARC for
  // send.relayrunner.app) live alongside the custom domain's records and are not touched by it.
  // Add relayrunner.dev here (and point VITE_SITE_URL in package.json at it) once that zone
  // lives in this account; a custom domain on a zone outside the account fails the deploy.
  "routes": [{ "pattern": "relayrunner.app", "custom_domain": true }],
}
