{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Landing page and docs (/docs): one Astro build served as static assets. The Worker script runs
  // first for /docs/* and / (run_worker_first), and for paths with no asset: it sends Markdown to
  // agents that ask for it with `Accept: text/markdown` and answers 404s. /ingest/* is PostHog,
  // forwarded by the Worker (packages/posthog-proxy). Every other file is
  // served from assets without invoking it.
  "name": "relayrunner-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-03",
  // The RelayRunner Cloudflare account (separate from Atticus's personal account).
  "account_id": "b233b6d6fd9eae9e093651bfb043c119",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/docs/*", "/ingest/*"],
    "html_handling": "drop-trailing-slash",
    // Unknown paths go to the Worker, which answers with dist/404.html (Starlight's not-found
    // page) and a 404, or a Markdown 404 for agents (worker/index.ts).
    "not_found_handling": "none",
  },
  "workers_dev": false,
  // PR preview builds (`wrangler preview` in Workers Builds) get public preview URLs.
  "preview_urls": true,
  // `wrangler preview` (branch preview builds) refuses to run without a previews block; it can be
  // empty because assets and compatibility settings stay at the top level.
  "previews": {},
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
  // Apexes of both domains. Each zone's MX/TXT records (Email Routing on relayrunner.app, Google
  // Workspace on relayrunner.dev) live alongside the custom domain's records and are not touched by
  // it. relayrunner.dev must have no A/AAAA/CNAME record on the apex before deploying, or the
  // custom domain fails to attach. SITE_URL in package.json is relayrunner.dev; a Redirect Rule on
  // the relayrunner.app zone sends the old apex there.
  "routes": [
    { "pattern": "relayrunner.app", "custom_domain": true },
    { "pattern": "relayrunner.dev", "custom_domain": true },
  ],
}
