---
// Homepage flowchart: one job goes through the relay and fans out to each runner in the order.
const DESTINATIONS = [
  { name: "Your machines", logo: "/providers/machines.svg" },
  { name: "Self-hosted runners", logo: "/providers/self-hosted.svg" },
  { name: "Blacksmith", logo: "/providers/blacksmith.svg" },
  { name: "GitHub-hosted", logo: "/providers/github.svg" },
];
// The last row stands for every other runner cloud, shown as a stack of a few of their logos.
const MORE_LOGOS = ["depot", "ubicloud", "boat", "namespace"];
// Connector end points, as a share of the fan's height, centred on each row (the "more" row included).
const rows = DESTINATIONS.length + 1;
const ends = Array.from({ length: rows }, (_, i) => ((i + 0.5) / rows) * 100);
---

<figure
  class="flow wrap"
  aria-label="Each GitHub Actions job goes through relayrunner to the first free runner in your order: your machines, self-hosted runners, Blacksmith, then GitHub-hosted, or many more runner clouds."
>
  <div class="flow-job" aria-hidden="true">
    <b class="label">GitHub Actions</b>
    <code>ci / test</code>
  </div>
  <span class="flow-line" aria-hidden="true"></span>
  <div class="flow-relay" aria-hidden="true">
    <img src="/assets/runner-head.svg" alt="" width="56" height="56" />
    <b>relayrunner</b>
  </div>
  <svg class="flow-fan" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {ends.map((y) => <path d={`M0 50 C 55 50, 45 ${y}, 100 ${y}`} />)}
  </svg>
  <span class="flow-line flow-line-down" aria-hidden="true"></span>
  <div class="flow-dest">
    <ol class="flow-rows" aria-hidden="true">
      {
        DESTINATIONS.map((d, i) => (
          <li>
            <span class="flow-num">{i + 1}</span>
            <img src={d.logo} alt="" width="28" height="28" />
            {d.name}
          </li>
        ))
      }
    </ol>
    <a class="flow-more" href="/integrations">
      <span class="flow-num" aria-hidden="true">+</span>
      <span class="flow-stack" aria-hidden="true">
        {MORE_LOGOS.map((id) => <img src={`/providers/${id}.svg`} alt="" width="24" height="24" />)}
      </span>
      <span class="flow-more-name">Many more runner clouds</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
    </a>
  </div>
</figure>

<style>
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px auto minmax(72px, 140px) minmax(0, 1.25fr);
    align-items: center;
    margin-top: 56px;
  }
  .flow-job {
    position: relative;
    justify-self: end;
  }
  .flow-job .label {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 0;
    white-space: nowrap;
  }
  .flow-job code {
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--raised);
    font-size: 16px;
    box-shadow: var(--shadow-card);
  }
  .flow-line {
    height: 2px;
    margin: 0 10px;
    background: var(--go-edge);
  }
  .flow-line-down {
    display: none;
  }
  .flow-relay {
    position: relative;
    padding: 0 6px;
  }
  .flow-relay b {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    font-size: 16px;
    transform: translateX(-50%);
  }
  .flow-fan {
    align-self: stretch;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .flow-fan path {
    fill: none;
    stroke: var(--go-edge);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .flow-dest,
  .flow-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .flow-dest {
    max-width: 380px;
  }
  .flow-dest li,
  .flow-more {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-deep);
    font-weight: 600;
  }
  .flow-more {
    color: var(--ink);
    text-decoration: none;
  }
  .flow-more:hover {
    border-color: var(--go-edge);
  }
  .flow-more-name {
    flex: 1;
    white-space: nowrap;
  }
  .flow-more svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--mute);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow-stack {
    display: flex;
    flex: none;
    padding: 2px 0;
  }
  .flow-stack img {
    position: relative;
    flex: none;
    border-radius: 6px;
    box-shadow: 0 0 0 2px var(--bg-deep);
  }
  .flow-stack img + img {
    margin-left: -8px;
  }
  .flow-stack img:nth-child(1) {
    z-index: 4;
  }
  .flow-stack img:nth-child(2) {
    z-index: 3;
  }
  .flow-stack img:nth-child(3) {
    z-index: 2;
  }
  .flow-dest li:first-child {
    border-color: var(--go-edge);
    background: var(--raised);
    box-shadow: var(--shadow-on);
  }
  .flow-num {
    width: 14px;
    color: var(--mute);
    font: 500 13px var(--mono);
  }
  .flow-dest li:first-child .flow-num {
    color: var(--go-text);
  }

  /* Phones: stack top to bottom and drop the fan. */
  @media (max-width: 720px) {
    .flow {
      grid-template-columns: 1fr;
      justify-items: center;
      margin-top: 40px;
    }
    .flow-job {
      justify-self: center;
      margin-top: 28px;
    }
    .flow-job .label {
      left: 50%;
      transform: translateX(-50%);
    }
    .flow-relay {
      margin-bottom: 30px;
    }
    .flow-line {
      width: 2px;
      height: 28px;
      margin: 10px 0;
    }
    .flow-line-down {
      display: block;
    }
    .flow-fan {
      display: none;
    }
    .flow-dest {
      width: 100%;
      min-width: 0;
    }
    .flow-more-name {
      white-space: normal;
      line-height: 1.25;
    }
    .flow-stack img:nth-child(n + 3) {
      display: none;
    }
  }
</style>
