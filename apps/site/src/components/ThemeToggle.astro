---
/*
 * Switches between light and dark. The click handler is in ThemeProvider.astro, so every toggle on
 * the page (header, docs mobile menu) works without a script of its own. Styles: header.css.
 */
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch light or dark theme">
  <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
    />
  </svg>
</button>
