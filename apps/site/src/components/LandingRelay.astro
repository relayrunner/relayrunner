---
import "../styles/landing-relay.css";
---
<div id="relay-finish" aria-hidden="true"></div>
<svg id="course" aria-hidden="true">
  <path opacity=".32"/>
  <path opacity=".18"/>
  <path opacity=".4" stroke-dasharray="2 12"/>
</svg>
<div id="athlete" class="relay-athlete" aria-hidden="true">
  <img alt="" style="position:absolute;width:100%;height:100%;object-fit:contain"/>
  <svg viewBox="-32 -32 64 64" style="width:100%;height:100%">
    <g fill="#8dbd53">
      <rect x="-11" y="1" width="8" height="18" rx="4"/>
      <rect x="3" y="1" width="8" height="18" rx="4"/>
    </g>
    <rect x="-12" y="-9" width="24" height="25" rx="9" fill="#66a641"/>
    <g fill="#faf1d9">
      <rect x="-21" y="-8" width="8" height="18" rx="4"/>
      <rect x="13" y="-8" width="8" height="18" rx="4"/>
    </g>
    <rect x="16" y="-14" width="4" height="15" rx="2" fill="#f6c96c"/>
    <rect x="-15" y="-19" width="30" height="24" rx="8" fill="#b3d95f"/>
    <rect x="-14" y="-20" width="28" height="21" rx="7" fill="#fff6de"/>
    <path d="M-10 -17 Q0 -21 10 -17" stroke="#16482e" stroke-width="3" fill="none"/>
    <circle cy="-6" r="3" fill="#82b448"/>
  </svg>
</div>
<script>
  import "../landing-relay.js";
</script>
