---
/*
 * Flat sidebar: section labels are small secondary text and page titles are the primary text.
 * Each group is a <details>: groups marked `collapsed` in astro.config.mjs start closed, unless
 * they hold the current page. Groups are only one level deep; a nested group renders as a flat list.
 * SidebarPersister and SidebarRestorePoint (Starlight's) keep the scroll position and each group's
 * open or closed state from page to page.
 */
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarRestorePoint from "@astrojs/starlight/components/SidebarRestorePoint.astro";

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];

const flatten = (entries: Entry[]): Extract<Entry, { type: "link" }>[] =>
  entries.flatMap((e) => (e.type === "link" ? [e] : flatten(e.entries)));

const { sidebar } = Astro.locals.starlightRoute;
---

<div class="rr-search"><Search /></div>

<SidebarPersister>
<nav class="rr-sidebar" aria-label="Docs">
  {
    sidebar.map((entry) =>
      entry.type === "link" ? (
        <a href={entry.href} aria-current={entry.isCurrent ? "page" : undefined}>
          {entry.label}
        </a>
      ) : (
        <details open={!entry.collapsed || flatten(entry.entries).some((link) => link.isCurrent)}>
          <summary>
            <h2>{entry.label}</h2>
            <svg class="caret" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M6 4l4 4-4 4" />
            </svg>
          </summary>
          <SidebarRestorePoint />
          <ul>
            {flatten(entry.entries).map((link) => (
              <li>
                <a href={link.href} aria-current={link.isCurrent ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ),
    )
  }
</nav>
</SidebarPersister>

<div class="md:sl-hidden"><MobileMenuFooter /></div>

<style>
  /* Search sits above the page list (the header is the landing page's, which has no room for it).
     Starlight's button is icon-only on small screens; here it's the full box at every width. */
  .rr-search {
    margin-bottom: 18px;
  }
  .rr-search :global(button[data-open-modal]) {
    width: 100%;
    height: 36px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding-inline: 10px 6px;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-3);
    font-size: 13px;
  }
  .rr-search :global(button[data-open-modal]:hover) {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
  .rr-search :global(button[data-open-modal] > span) {
    display: block;
  }
  .rr-search :global(button[data-open-modal] > :last-child) {
    margin-inline-start: auto;
  }
  .rr-sidebar {
    display: flex;
    flex-direction: column;
  }
  details + details {
    margin-top: 10px;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 8px;
    border-radius: 5px;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--sl-color-white);
  }
  summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .caret {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease;
  }
  details[open] > summary .caret {
    transform: rotate(90deg);
  }
  details[open] > ul {
    margin-top: 4px;
  }
  h2 {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: inherit;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    padding: 4px 8px;
    border-radius: 5px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  a[aria-current="page"] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
</style>
