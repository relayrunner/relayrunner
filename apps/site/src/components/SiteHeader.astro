---
/*
 * The site header, shared by the landing pages and the docs: Solutions and Providers menus, Docs
 * and Changelog. The menus are native popovers, so they open on click, close on Escape or a click
 * outside, and need no script.
 *
 * Signed-in visitors get Open dashboard in place of Sign in and Get started. The dashboard sets the
 * rr_signed_in cookie on this domain (apps/web/src/lib/auth-client.ts); the inline script reads it
 * before the buttons paint, so they don't flicker.
 *
 * Narrow screens get a menu button that opens every link (also a popover).
 */
import { INTEGRATION_IDS, integrationPath } from "../lib/integrations";
import { logoOf, PROVIDERS } from "../lib/providers";
import { SOLUTIONS, solutionPath } from "../lib/solutions";
import BrandSymbol from "./BrandSymbol.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Set on the home page, where the brand and Get started scroll instead of navigating. */
  home?: boolean;
  /** The narrow-screen menu. The docs turn it off: Starlight has its own. */
  menu?: boolean;
}

const { home = false, menu = true } = Astro.props;
const path = Astro.url.pathname;
const inChangelog = path.startsWith("/docs/changelog");
const inDocs = path.startsWith("/docs") && !inChangelog;
const inSolutions = path.startsWith("/solutions");
const inIntegrations = path.startsWith("/integrations");
const DASHBOARD = "https://app.relayrunner.app";
const LOGIN = `${DASHBOARD}/login`;
const GITHUB = "https://github.com/relayrunner/relayrunner";

const more = [
  {
    href: "/docs/get-started/agents",
    name: "Coding agents",
    blurb: "Set up and check CI from your agent",
  },
  {
    href: "/docs/reference/security",
    name: "Security",
    blurb: "What runs where, and who can see it",
  },
];
const routes = [
  {
    href: "/docs/runners/self-hosted",
    logo: "/providers/machines.svg",
    name: "Your machines",
    blurb: "Any Mac or Linux computer",
  },
  {
    href: "/docs/runners/self-hosted#runners-your-org-already-has",
    logo: "/providers/self-hosted.svg",
    name: "Self-hosted runners",
    blurb: "The runners your org already has",
  },
  {
    href: "/docs/runners/github",
    logo: "/providers/github.svg",
    name: "GitHub-hosted",
    blurb: "The minutes in your plan",
  },
  {
    href: "/integrations",
    // A cluster of four providers' marks, so the item stands for all of them.
    cluster: INTEGRATION_IDS.slice(0, 4).map((id) => logoOf(id)!),
    name: "Hosted providers",
    blurb: "Faster runners on your own account",
  },
];
const CHEVRON = "M6 9l6 6 6-6";
---

<header class="site-header" data-header>
  <div class="wrap header-row">
    <a class="brand" href={home ? "#top" : "/"} aria-label="relayrunner home">
      <BrandSymbol />
      relayrunner
    </a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        <li class="nav-page">
          <button
            class="nav-trigger"
            type="button"
            popovertarget="nav-solutions"
            aria-current={inSolutions ? "page" : undefined}
          >
            Solutions
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={CHEVRON} /></svg>
          </button>
          <div id="nav-solutions" class="nav-panel nav-panel-solutions" popover>
            <div class="nav-panel-main">
              <ul class="nav-grid">
                {
                  SOLUTIONS.map((s, i) => (
                    <li class={i === 0 ? "nav-grid-wide" : undefined}>
                      <a class:list={["nav-item", { "nav-featured": i === 0 }]} href={solutionPath(s)}>
                        <span class="nav-icon">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d={s.icon} />
                          </svg>
                        </span>
                        <span class="nav-item-text">
                          <b>{s.name}</b>
                          <span>{s.blurb}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="nav-panel-side">
              <p class="nav-panel-label">More</p>
              <ul>
                {
                  more.map((m) => (
                    <li>
                      <a class="nav-item" href={m.href}>
                        <span class="nav-item-text">
                          <b>{m.name}</b>
                          <span>{m.blurb}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="nav-panel-foot">
              <span>New here? Set up a runner with one command.</span>
              <code><span aria-hidden="true">$ </span>npx relayrunner connect</code>
              <a href="/docs/get-started/quickstart">Quickstart →</a>
            </div>
          </div>
        </li>
        <li class="nav-page">
          <button
            class="nav-trigger"
            type="button"
            popovertarget="nav-providers"
            aria-current={inIntegrations ? "page" : undefined}
          >
            Providers
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={CHEVRON} /></svg>
          </button>
          <div id="nav-providers" class="nav-panel nav-panel-providers" popover>
            <div class="nav-panel-main">
              <p class="nav-panel-label">Route jobs to</p>
              <ul class="nav-grid">
                {
                  routes.map((r) => (
                    <li>
                      <a class="nav-item" href={r.href}>
                        {r.cluster ? (
                          <span class="nav-cluster" aria-hidden="true">
                            {r.cluster.map((src) => (
                              <img src={src} alt="" width="17" height="17" loading="lazy" />
                            ))}
                          </span>
                        ) : (
                          <img src={r.logo} alt="" width="36" height="36" loading="lazy" />
                        )}
                        <span class="nav-item-text">
                          <b>{r.name}</b>
                          <span>{r.blurb}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="nav-panel-foot">
              <ul class="nav-logos" aria-label="Integrations">
                {
                  INTEGRATION_IDS.map((id) => (
                    <li>
                      <a href={integrationPath(id)} title={PROVIDERS[id].name}>
                        <img
                          src={logoOf(id)}
                          alt={PROVIDERS[id].name}
                          width="24"
                          height="24"
                          loading="lazy"
                        />
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a href="/integrations">All integrations →</a>
            </div>
          </div>
        </li>
        <li><a href="/docs" aria-current={inDocs ? "page" : undefined}>Docs</a></li>
        <li class="nav-page">
          <a href="/docs/changelog" aria-current={inChangelog ? "page" : undefined}>Changelog</a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <script is:inline>
        if (/(?:^|; )rr_signed_in=1/.test(document.cookie)) {
          document.currentScript.parentElement.dataset.signedIn = "";
        }
      </script>
      <ThemeToggle />
      <a class="header-github" href={GITHUB} aria-label="relayrunner on GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          />
        </svg>
      </a>
      <a class="btn-text btn-sm signed-out" href={LOGIN}>Sign in</a>
      <a class="btn-go btn-sm signed-out" href={home ? "#start" : "/#start"}>Get started</a>
      <a class="btn-go btn-sm signed-in" href={DASHBOARD}>Open dashboard</a>
      {
        menu && (
          <>
            <button
              class="menu-toggle"
              type="button"
              popovertarget="site-menu"
              aria-label="Menu"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="menu-open" d="M4 7h16M4 12h16M4 17h16" />
                <path class="menu-close" d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
            <nav id="site-menu" class="site-menu" popover aria-label="Menu" data-site-menu>
              <p class="site-menu-label">Solutions</p>
              <ul>
                {SOLUTIONS.map((s) => (
                  <li>
                    <a href={solutionPath(s)}>{s.name}</a>
                  </li>
                ))}
              </ul>
              <ul class="site-menu-rest">
                <li>
                  <a href="/integrations">Integrations</a>
                </li>
                <li>
                  <a href="/docs">Docs</a>
                </li>
                <li>
                  <a href="/docs/changelog">Changelog</a>
                </li>
                <li>
                  <a href={GITHUB}>GitHub</a>
                </li>
                <li class="signed-out">
                  <a href={LOGIN}>Sign in</a>
                </li>
                <li class="signed-in">
                  <a href={DASHBOARD}>Open dashboard</a>
                </li>
              </ul>
              <div class="site-menu-theme">
                Theme
                <ThemeToggle />
              </div>
            </nav>
          </>
        )
      }
    </div>
  </div>
</header>

<script>
  // Open a menu when a mouse rests on its item, and close it shortly after the mouse leaves both
  // the item and its panel (the panel sits inside the item). Clicks, touch and keys work as before.
  const OPEN_DELAY = 80;
  const CLOSE_DELAY = 200;
  for (const item of document.querySelectorAll<HTMLElement>(".nav-page")) {
    const trigger = item.querySelector<HTMLButtonElement>("[popovertarget]");
    const panel = item.querySelector<HTMLElement>("[popover]");
    if (!trigger || !panel) continue;
    let timer: number | undefined;
    let hoverOpened = false;
    const later = (fn: () => void, ms: number) => {
      clearTimeout(timer);
      timer = window.setTimeout(fn, ms);
    };
    item.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      later(() => {
        if (panel.matches(":popover-open")) return;
        panel.showPopover();
        hoverOpened = true;
      }, OPEN_DELAY);
    });
    item.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "mouse") return;
      later(() => {
        if (hoverOpened && panel.matches(":popover-open")) panel.hidePopover();
        hoverOpened = false;
      }, CLOSE_DELAY);
    });
    // A click on a menu the mouse already opened keeps it open instead of closing it.
    trigger.addEventListener("click", (event) => {
      if (hoverOpened && panel.matches(":popover-open")) {
        event.preventDefault();
        hoverOpened = false;
      }
    });
    panel.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState === "closed") hoverOpened = false;
    });
  }
</script>
