---
/*
 * The site header: the landing page's header, shared with the docs. On the home page the links are
 * in-page anchors; elsewhere (the docs) they point back at the home page's sections. Docs stays
 * visible down to the narrowest layout that shows the nav.
 *
 * Signed-in visitors get Open dashboard in place of Sign in and Get started. The dashboard sets the
 * rr_signed_in cookie on this domain (apps/web/src/lib/auth-client.ts); the inline script reads it
 * before the buttons paint, so they don't flicker.
 */
interface Props {
  /** Set on the home page, where the links scroll to sections instead of navigating. */
  home?: boolean;
}

const { home = false } = Astro.props;
const to = (hash: string) => (home ? hash : `/${hash}`);
const inDocs = Astro.url.pathname.startsWith("/docs");
const DASHBOARD = "https://app.relayrunner.app";
---

<header class="site-header" data-header>
  <div class="wrap header-row">
    <a class="brand" href={home ? "#top" : "/"} aria-label="relayrunner home">
      <span class="brand-symbol" aria-hidden="true"></span>
      relayrunner
    </a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        <li><a href="/docs" aria-current={inDocs ? "page" : undefined}>Docs</a></li>
        <li class="nav-page"><a href={to("#providers")}>Providers</a></li>
        <li class="nav-page"><a href={to("#how")}>How it works</a></li>
        <li class="nav-page"><a href={to("#checks")}>Optimized checks</a></li>
        <li class="nav-page"><a href={to("#safety")}>Security</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <script is:inline>
        if (/(?:^|; )rr_signed_in=1/.test(document.cookie)) {
          document.currentScript.parentElement.dataset.signedIn = "";
        }
      </script>
      <a class="btn-ghost btn-sm header-github" href="https://github.com/relayrunner/relayrunner"
        >GitHub</a
      >
      <a class="btn-text btn-sm signed-out" href={`${DASHBOARD}/login`}>Sign in</a>
      <a class="btn-go btn-sm signed-out" href={to("#start")}>Get started</a>
      <a class="btn-go btn-sm signed-in" href={DASHBOARD}>Open dashboard</a>
    </div>
  </div>
</header>
