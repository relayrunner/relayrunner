---
/*
 * The frame around a landing page that isn't the home page (solutions, integrations): head tags,
 * header, the page's own content as the default slot, footer and the copy-button script. Page-only
 * head tags, such as structured data, go in the "head" slot.
 */
import PageMeta from "../components/PageMeta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../style.css";
import "../styles/solutions.css";

interface Props {
  /** The page's <title> and share title, without the site name. */
  title: string;
  /** Meta description and share text. */
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <PageMeta title={`${title} · relayrunner`} {description} {path}>
      <slot name="head" />
    </PageMeta>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <p class="visually-hidden" aria-live="polite" data-announce></p>
    <script>
      import "../main.ts";
    </script>
  </body>
</html>
