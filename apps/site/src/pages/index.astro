---
// Moved from index.html; the header is now the shared SiteHeader. Astro bundles the imported CSS into the page's <head>.
import CloseBox from "../components/CloseBox.astro";
import LandingRelay from "../components/LandingRelay.astro";
import RoutingFlow from "../components/RoutingFlow.astro";
import PageMeta from "../components/PageMeta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProviderLogo from "../components/docs/ProviderLogo.astro";
import { KNOWN_PROVIDERS, PROVIDERS } from "../lib/providers";
import "../style.css";

const site = Astro.site!.origin;
// Logo row: the providers without a card above (Cloudflare is RelayRunner's own runner).
const MORE_PROVIDERS = KNOWN_PROVIDERS.filter(
  (id) => !["blacksmith", "github", "cloudflare"].includes(id),
);
// Structured data for search engines and agents: the project and what it is. Keywords use terms
// that appear on the page.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: "RelayRunner",
      url: `${site}/`,
      logo: `${site}/favicon.png`,
      sameAs: ["https://github.com/relayrunner", "https://www.npmjs.com/package/relayrunner"],
    },
    {
      "@type": "SoftwareApplication",
      name: "RelayRunner",
      url: `${site}/`,
      description:
        "Send each GitHub Actions job to the first free runner in your order: your own machines, self-hosted runners, a hosted provider or GitHub-hosted.",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux",
      keywords: "GitHub Actions, self-hosted runners, CI runner",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      softwareHelp: `${site}/docs`,
      publisher: { "@id": `${site}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <PageMeta
      title="relayrunner: one router for every CI runner"
      description="Send each GitHub Actions job to the first free runner in your order: your own machines, self-hosted runners, Blacksmith or GitHub-hosted. Change the order any time without editing your workflows."
      shareDescription="Send each GitHub Actions job to the first free runner in your order: your machines, self-hosted runners, Blacksmith or GitHub-hosted. No workflow changes."
      path="/"
    >
      <link rel="alternate" type="text/markdown" href="/index.md" />
      <link rel="service-desc" type="application/json" href="/openapi.json" />
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    </PageMeta>
    <link rel="preload" as="image" href="/mascot.webp" type="image/webp" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader home />

    <main id="main">
      <!-- Hero -->
      <section class="hero wrap" id="top">
        <img class="mascot" src="/mascot.webp" alt="" width="240" height="317" />
        <p class="eyebrow">Open source · Smart routing for GitHub Actions</p>
        <h1>One router for <span class="hl">every CI&nbsp;runner</span></h1>
        <p class="lede">
          Change runners with zero code changes. Each GitHub Actions job goes to the first free
          runner in your order.
        </p>
        <div class="hero-actions">
          <a class="btn-go btn-lg" href="https://app.relayrunner.app">Get started with GitHub</a>
          <button class="cmd" type="button" data-copy-inline="npx relayrunner connect">
            <span aria-hidden="true">$</span> <code>npx relayrunner connect</code>
            <span class="visually-hidden">Copy command</span>
          </button>
        </div>
        <p class="hero-note">
          Or <button
            class="link-btn"
            type="button"
            data-copy-inline="Set up relayrunner in this checkout using https://raw.githubusercontent.com/relayrunner/relayrunner/main/docs/agent-install.md"
            data-copied-label="copied the instruction"
          >
            <code>copy one line</code>
          </button>
          into Claude Code, Codex or Cursor and your agent does the setup.
        </p>
      </section>

      <RoutingFlow />

      <!-- Routing demo -->
      <section class="wrap" aria-label="Routing demo">
        <div class="stage">
          <div class="stage-side">
            <div class="term">
              <div class="term-bar">~/acme-api</div>
              <div class="term-body">
                <div><span class="mute">$</span> npx relayrunner connect</div>
                <div class="go-text">✓ Online. Waiting for jobs.</div>
                <div><span class="mute">$</span> git push</div>
                <div class="mute">→ ci / test · PR #<span data-pr>482</span></div>
              </div>
            </div>
            <div class="next-card" aria-live="polite">
              <b class="label">Next job goes to</b>
              <span class="next-name"
                ><img
                  data-next-logo
                  src="/providers/machines.svg"
                  alt=""
                  width="28"
                  height="28"
                /><span data-next-name>Zach's MacBook Pro</span></span
              >
              <span class="next-why" data-next-why
                >The first free runner in your order. Uses no GitHub minutes.</span
              >
            </div>
          </div>
          <div class="order">
            <div class="order-head">
              <b class="label">Runner order</b>
              <span>Move a runner up to change where the next job goes.</span>
            </div>
            <ol class="lanes" data-lanes>
              <li
                class="lane"
                data-lane="machine"
                data-next="Zach's MacBook Pro"
                data-why="The first free runner in your order. Uses no GitHub minutes."
              >
                <img src="/providers/machines.svg" alt="" width="32" height="32" />
                <span class="lane-name"
                  ><b>Self-hosted</b><code>3 machines · 1 org runner</code></span
                >
                <code class="lane-rule">when free</code>
                <span class="lane-state"></span>
                <button class="lane-up" type="button" aria-label="Move Self-hosted up">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                </button>
              </li>
              <li
                class="lane"
                data-lane="github"
                data-next="GitHub-hosted"
                data-why="Uses your included minutes until you reach your cap."
              >
                <img src="/providers/github.svg" alt="" width="32" height="32" />
                <span class="lane-name"><b>GitHub-hosted</b><code>ubuntu-latest</code></span>
                <code class="lane-rule">under 80% of minutes</code>
                <span class="lane-state"></span>
                <button class="lane-up" type="button" aria-label="Move GitHub-hosted up">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                </button>
              </li>
              <li
                class="lane"
                data-lane="blacksmith"
                data-next="Blacksmith"
                data-why="Runs on your Blacksmith account."
              >
                <img src="/providers/blacksmith.svg" alt="" width="32" height="32" />
                <span class="lane-name"
                  ><b>Blacksmith</b><code>blacksmith-2vcpu-ubuntu-2404</code></span
                >
                <code class="lane-rule">always</code>
                <span class="lane-state"></span>
                <button class="lane-up" type="button" aria-label="Move Blacksmith up">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                </button>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Your machine -->
      <section class="section wrap feature" id="connect">
        <div class="feature-copy">
          <p class="kicker">Your machines</p>
          <h2>Turn any computer into a runner <span class="hl">with one command.</span></h2>
          <p class="body">
            Run <code>npx relayrunner connect</code> on a laptop, Mac mini or home server and it starts
            taking jobs. Close the lid and jobs go to the next runner in your order. Share it with your
            team or keep it private.
          </p>
        </div>
        <div class="panel connect-panel" aria-hidden="true">
          <div class="term">
            <div class="term-bar">~/acme-api</div>
            <div class="term-body">
              <div><span class="mute">$</span> npx relayrunner connect</div>
              <div class="go-text">✓ Zach's MacBook Pro is online</div>
              <div class="mute">→ ci / test · running here</div>
              <div class="mute">→ ci / typecheck · done in 48s</div>
            </div>
          </div>
          <div class="machines">
            <div class="machine">
              <b
                ><img src="/providers/machines.svg" alt="" width="24" height="24" />Zach's MacBook
                Pro</b
              >
              <code>macOS · ARM64 · 12 cores · 36 GB</code>
              <div class="machine-foot">
                <span>Zach · shared with team</span><span><i class="dot go-dot"></i>online</span>
              </div>
            </div>
            <div class="machine">
              <b><img src="/providers/machines.svg" alt="" width="24" height="24" />build-mini</b>
              <code>macOS · ARM64 · 10 cores · 32 GB</code>
              <div class="machine-foot">
                <span>Atticus · private</span><span><i class="dot run-dot"></i>paused</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Providers -->
      <section class="section wrap" id="providers" aria-labelledby="providers-h">
        <div class="split-head">
          <div>
            <p class="kicker">Providers</p>
            <h2 id="providers-h">
              Route jobs to the runners <span class="hl">you already have.</span>
            </h2>
          </div>
          <p class="body">
            Each provider is a step in your runner order. Add, reorder or remove them in the
            dashboard.
          </p>
        </div>
        <ul class="provider-grid">
          <li class="provider-card">
            <img src="/providers/machines.svg" alt="" width="48" height="48" />
            <h3>Your machines</h3>
            <p>
              Mac and Linux computers you connect with one command.
            </p>
            <code class="provider-cmd">npx relayrunner connect</code>
          </li>
          <li class="provider-card">
            <img src="/providers/self-hosted.svg" alt="" width="48" height="48" />
            <h3>Self-hosted runners</h3>
            <p>The runners already registered in your GitHub org. Nothing to change.</p>
          </li>
          <li class="provider-card">
            <img src="/providers/blacksmith.svg" alt="" width="48" height="48" />
            <h3>Blacksmith</h3>
            <p>Connect your Blacksmith account and place it anywhere in your order.</p>
          </li>
          <li class="provider-card">
            <img src="/providers/github.svg" alt="" width="48" height="48" />
            <h3>GitHub-hosted</h3>
            <p>
              The minutes included in your plan, with a cap so you don't pay overage.
            </p>
          </li>
        </ul>
        <ul class="logo-row" aria-label="More providers">
          {
            MORE_PROVIDERS.map((id) => (
              <li>
                <ProviderLogo id={id} size={26} />
                {PROVIDERS[id].name}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Switch -->
      <section class="section wrap feature" id="how">
        <div class="feature-copy">
          <p class="kicker">Switch</p>
          <h2>Change where jobs run <span class="hl">in seconds.</span></h2>
          <p class="body">
            Try a new provider, move work onto your machines, or send everything back to GitHub.
            You change the order in the dashboard, without a commit or pull request, and it applies
            to the next job.
          </p>
        </div>
        <div class="panel" aria-hidden="true">
          <div class="mini-lanes">
            <div class="mini-lane">
              <code>1</code><img src="/providers/machines.svg" alt="" width="28" height="28" /><b
                >Self-hosted</b
              ><span>3 machines · 1 runner</span>
            </div>
            <div class="mini-lane moving">
              <code>2</code><img src="/providers/blacksmith.svg" alt="" width="28" height="28" /><b
                >Blacksmith</b
              ><span class="go">moved up</span>
            </div>
            <div class="mini-lane">
              <code>3</code><img src="/providers/github.svg" alt="" width="28" height="28" /><b
                >GitHub-hosted</b
              ><span>fallback</span>
            </div>
          </div>
          <p class="panel-note">Saved. <b>Next job:</b> Blacksmith, if no machine is free.</p>
        </div>
      </section>

      <!-- Minutes -->
      <section class="section wrap feature feature-flip">
        <div class="panel" aria-hidden="true">
          <div class="meter-card">
            <div class="meter-head">
              <b><img src="/providers/github.svg" alt="" width="28" height="28" />GitHub-hosted</b>
              <code>capped at 80%</code>
            </div>
            <div class="meter">
              <div class="meter-fill" data-meter></div>
              <div class="meter-cap"></div>
            </div>
            <div class="meter-foot">
              <span><b class="run">2,220</b> of 3,000 included minutes</span>
            </div>
          </div>
          <p class="panel-note">
            Past the limit, jobs fall through to <b>Self-hosted</b>, then <b>Blacksmith</b>.
          </p>
        </div>
        <div class="feature-copy">
          <p class="kicker">Minutes</p>
          <h2>Stay inside your <span class="hl">included minutes.</span></h2>
          <p class="body">
            Set a cap on GitHub-hosted as a share of the minutes your plan includes. Once you reach
            it, jobs go to the next runner in your order.
          </p>
        </div>
      </section>

      <!-- See -->
      <section class="section wrap feature">
        <div class="feature-copy">
          <p class="kicker">Compare</p>
          <h2>Compare providers <span class="hl">on your own jobs.</span></h2>
          <p class="body">
            Every job shows where it ran and why. See how long the same job takes on each runner,
            and how much you use each provider.
          </p>
        </div>
        <div class="panel" aria-hidden="true">
          <div class="times">
            <div class="times-row times-head">
              <span>Job</span>
              <span
                ><img src="/providers/machines.svg" alt="" width="20" height="20" />Machine</span
              >
              <span
                ><img
                  src="/providers/blacksmith.svg"
                  alt=""
                  width="20"
                  height="20"
                />Blacksmith</span
              >
              <span><img src="/providers/github.svg" alt="" width="20" height="20" />GitHub</span>
            </div>
            <div class="times-row">
              <b>ci / test</b><code>1m 52s</code><code>2m 10s</code><code>3m 41s</code>
            </div>
            <div class="times-row">
              <b>ci / typecheck</b><code>0m 48s</code><code>1m 05s</code><code>1m 24s</code>
            </div>
            <div class="times-row">
              <b>ci / build</b><code>2m 30s</code><code>2m 02s</code><code>4m 12s</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Optimized checks -->
      <section class="section wrap feature feature-flip" id="checks">
        <div class="panel" aria-hidden="true">
          <ul class="checks">
            <li>
              <i class="dot go-dot"></i><b>PR title</b><span>feat(api): add provider pages</span
              ><code>0 min billed</code>
            </li>
            <li>
              <i class="dot go-dot"></i><b>oxlint</b><span>0 new findings</span
              ><code>0 min billed</code>
            </li>
            <li>
              <i class="dot run-dot"></i><b>actionlint</b><span>1 finding</span
              ><code>0 min billed</code>
            </li>
          </ul>
        </div>
        <div class="feature-copy">
          <p class="kicker">Optimized checks <span class="kicker-note">Preview</span></p>
          <h2>Run simple checks <span class="hl">without using minutes.</span></h2>
          <p class="body">
            PR title and lint checks (oxlint, ruff, actionlint and more) finish in seconds, but a
            hosted runner bills each one as a full minute. Run them as optimized checks
            instead: they need no runner, post results to your pull request and use no minutes.
          </p>
        </div>
      </section>

      <!-- Safety -->
      <section class="section wrap" id="safety" aria-labelledby="safety-h">
        <p class="kicker">Security</p>
        <h2 id="safety-h">Safe defaults for CI on <span class="hl">your own machines.</span></h2>
        <ul class="safety-grid">
          <li>
            <h3>Hosted runners stay as the fallback</h3>
            <p>If your machine is offline, the job runs on the next runner in your order.</p>
          </li>
          <li>
            <h3>Public repos don't use your machines</h3>
            <p>Code from a stranger's pull request never runs on your computer.</p>
          </li>
          <li>
            <h3>Shared machines follow repo access</h3>
            <p>A shared machine only takes jobs from repos its owner can read.</p>
          </li>
          <li>
            <h3>Jobs fail with a reason</h3>
            <p>If no runner can take a job, it fails and tells you why instead of waiting in the queue.</p>
          </li>
        </ul>
      </section>

      <!-- Close -->
      <CloseBox
        heading="Get started in two commands."
        body="Connect a computer, then choose which jobs to route. Your current runners stay as the fallback."
        steps={[
          { label: "Turn this computer into a runner", command: "npx relayrunner connect" },
          { label: "In your repo, pick the jobs to route", command: "npx relayrunner init" },
        ]}
      />
    </main>

    <SiteFooter home />

    <LandingRelay />
    <p class="visually-hidden" aria-live="polite" data-announce></p>
    <script>
      import "../main.ts";
    </script>
  </body>
</html>
