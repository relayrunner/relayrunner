---
// Moved from index.html; the header is now the shared SiteHeader. Astro bundles the imported CSS into the page's <head>.
import SiteHeader from "../components/SiteHeader.astro";
import ProviderLogo from "../components/docs/ProviderLogo.astro";
import { KNOWN_PROVIDERS, PROVIDERS } from "../lib/providers";
import "../style.css";

const site = Astro.site!.origin;
// Logo row: the providers without a card above (Cloudflare is RelayRunner's own runner).
const MORE_PROVIDERS = KNOWN_PROVIDERS.filter(
  (id) => !["blacksmith", "github", "cloudflare"].includes(id),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>relayrunner: one router for every CI runner</title>
    <meta
      name="description"
      content="relayrunner sends each GitHub Actions job to the best runner available right now: your own machines, self-hosted runners, Blacksmith or GitHub-hosted. Change the order any time. Your workflows don't change."
    />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={`${site}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="relayrunner" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:title" content="relayrunner: one router for every CI runner" />
    <meta
      property="og:description"
      content="Send each GitHub Actions job to the best runner available right now: your machines, self-hosted runners, Blacksmith or GitHub-hosted. No workflow changes."
    />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="relayrunner: one router for every CI runner. A runner order sends the next job to your machines, then GitHub-hosted, then Blacksmith."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="relayrunner: one router for every CI runner" />
    <meta
      name="twitter:description"
      content="Send each GitHub Actions job to the best runner available right now: your machines, self-hosted runners, Blacksmith or GitHub-hosted. No workflow changes."
    />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <meta
      name="twitter:image:alt"
      content="relayrunner: one router for every CI runner. A runner order sends the next job to your machines, then GitHub-hosted, then Blacksmith."
    />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/mascot.webp" type="image/webp" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader home />

    <main id="main">
      <!-- Hero -->
      <section class="hero wrap" id="top">
        <img class="mascot" src="/mascot.webp" alt="" width="240" height="317" />
        <p class="eyebrow">Open source · Smart routing for GitHub Actions</p>
        <h1>One router for <span class="hl">every CI&nbsp;runner.</span></h1>
        <p class="lede">
          relayrunner sends each GitHub Actions job to the best runner available right now: your own
          machines, self-hosted runners, a cloud provider like Blacksmith, or GitHub-hosted. Change
          the order any time. Your workflows don't change.
        </p>
        <div class="hero-actions">
          <a class="btn-go btn-lg" href="https://app.relayrunner.app">Get started with GitHub</a>
          <button class="cmd" type="button" data-copy-inline="npx relayrunner init">
            <span aria-hidden="true">$</span> <code>npx relayrunner init</code>
            <span class="visually-hidden">Copy command</span>
          </button>
        </div>
        <p class="hero-note">
          Or
          <button
            class="link-btn"
            type="button"
            data-copy-inline="Set up relayrunner in this checkout using https://raw.githubusercontent.com/relayrunner/relayrunner/main/docs/agent-install.md"
            data-copied-label="copied the instruction"
          >
            <code>copy one line</code>
          </button>
          into Claude Code, Codex or Cursor and let your agent set it up.
        </p>
      </section>

      <!-- Routing demo -->
      <section class="wrap" aria-label="Routing demo">
        <div class="stage">
          <div class="stage-side">
            <div class="term">
              <div class="term-bar">~/acme-api</div>
              <div class="term-body">
                <div><span class="mute">$</span> git push</div>
                <div class="mute">→ ci / test · PR #<span data-pr>482</span></div>
              </div>
            </div>
            <div class="next-card" aria-live="polite">
              <b class="label">Next job goes to</b>
              <span class="next-name"
                ><img
                  data-next-logo
                  src="/providers/machines.svg"
                  alt=""
                  width="28"
                  height="28"
                /><span data-next-name>Zach's MacBook Pro</span></span
              >
              <span class="next-why" data-next-why
                >First free runner in your order. GitHub minutes untouched.</span
              >
            </div>
          </div>
          <div class="order">
            <div class="order-head">
              <b class="label">Runner order</b>
              <span>Move a runner up. The next job follows.</span>
            </div>
            <ol class="lanes" data-lanes>
              <li
                class="lane"
                data-lane="machine"
                data-next="Zach's MacBook Pro"
                data-why="First free runner in your order. GitHub minutes untouched."
              >
                <img src="/providers/machines.svg" alt="" width="32" height="32" />
                <span class="lane-name"
                  ><b>Self-hosted</b><code>3 machines · 1 org runner</code></span
                >
                <code class="lane-rule">when free</code>
                <span class="lane-state"></span>
                <button class="lane-up" type="button" aria-label="Move Self-hosted up">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                </button>
              </li>
              <li
                class="lane"
                data-lane="github"
                data-next="GitHub-hosted"
                data-why="Included minutes, until you reach your cap."
              >
                <img src="/providers/github.svg" alt="" width="32" height="32" />
                <span class="lane-name"><b>GitHub-hosted</b><code>ubuntu-latest</code></span>
                <code class="lane-rule">under 80% of minutes</code>
                <span class="lane-state"></span>
                <button class="lane-up" type="button" aria-label="Move GitHub-hosted up">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                </button>
              </li>
              <li
                class="lane"
                data-lane="blacksmith"
                data-next="Blacksmith"
                data-why="Your Blacksmith account, first in line."
              >
                <img src="/providers/blacksmith.svg" alt="" width="32" height="32" />
                <span class="lane-name"
                  ><b>Blacksmith</b><code>blacksmith-2vcpu-ubuntu-2404</code></span
                >
                <code class="lane-rule">always</code>
                <span class="lane-state"></span>
                <button class="lane-up" type="button" aria-label="Move Blacksmith up">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                </button>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Providers -->
      <section class="section wrap" id="providers" aria-labelledby="providers-h">
        <div class="split-head">
          <div>
            <p class="kicker">Providers</p>
            <h2 id="providers-h">
              Every runner you have, <span class="hl">behind one router.</span>
            </h2>
          </div>
          <p class="body">
            Each provider is a step in your runner order. Add one, move it up or take it out from
            the dashboard, and the next job follows.
          </p>
        </div>
        <ul class="provider-grid">
          <li class="provider-card">
            <img src="/providers/machines.svg" alt="" width="48" height="48" />
            <h3>Your machines</h3>
            <p>
              Macs and Linux boxes take one job at a time while they're on. Close the lid and jobs
              go elsewhere.
            </p>
          </li>
          <li class="provider-card">
            <img src="/providers/self-hosted.svg" alt="" width="48" height="48" />
            <h3>Self-hosted runners</h3>
            <p>Runners your org already has, in the runner groups you choose.</p>
          </li>
          <li class="provider-card">
            <img src="/providers/blacksmith.svg" alt="" width="48" height="48" />
            <h3>Blacksmith</h3>
            <p>Bring your Blacksmith account and put it anywhere in your order.</p>
          </li>
          <li class="provider-card">
            <img src="/providers/github.svg" alt="" width="48" height="48" />
            <h3>GitHub-hosted</h3>
            <p>
              The minutes your plan includes, with a cap so a busy week never turns into overage.
            </p>
          </li>
        </ul>
        <ul class="logo-row" aria-label="More providers">
          {
            MORE_PROVIDERS.map((id) => (
              <li>
                <ProviderLogo id={id} size={26} />
                {PROVIDERS[id].name}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Switch -->
      <section class="section wrap feature" id="how">
        <div class="feature-copy">
          <p class="kicker">Switch</p>
          <h2>Change where jobs run <span class="hl">in seconds.</span></h2>
          <p class="body">
            Try a new provider, move a busy week onto your machines, or send everything back to
            GitHub, all from the dashboard. No pull request, no commit. The next job follows the new
            order.
          </p>
          <p class="aside">
            If nothing fits, the job fails right away with the reason instead of sitting in a queue.
          </p>
        </div>
        <div class="panel" aria-hidden="true">
          <div class="mini-lanes">
            <div class="mini-lane">
              <code>1</code><img src="/providers/machines.svg" alt="" width="28" height="28" /><b
                >Self-hosted</b
              ><span>3 machines · 1 runner</span>
            </div>
            <div class="mini-lane moving">
              <code>2</code><img src="/providers/blacksmith.svg" alt="" width="28" height="28" /><b
                >Blacksmith</b
              ><span class="go">moved up</span>
            </div>
            <div class="mini-lane">
              <code>3</code><img src="/providers/github.svg" alt="" width="28" height="28" /><b
                >GitHub-hosted</b
              ><span>fallback</span>
            </div>
          </div>
          <p class="panel-note">Saved. <b>Next job:</b> Blacksmith, if no machine is free.</p>
        </div>
      </section>

      <!-- Minutes -->
      <section class="section wrap feature feature-flip">
        <div class="panel" aria-hidden="true">
          <div class="meter-card">
            <div class="meter-head">
              <b><img src="/providers/github.svg" alt="" width="28" height="28" />GitHub-hosted</b>
              <code>capped at 80%</code>
            </div>
            <div class="meter">
              <div class="meter-fill" data-meter></div>
              <div class="meter-cap"></div>
            </div>
            <div class="meter-foot">
              <span><b class="run">2,220</b> of 3,000 included minutes</span>
            </div>
          </div>
          <p class="panel-note">
            Past the limit, jobs fall through to <b>Self-hosted</b>, then <b>Blacksmith</b>.
          </p>
        </div>
        <div class="feature-copy">
          <p class="kicker">Minutes</p>
          <h2>Spend included minutes, <span class="hl">not overage.</span></h2>
          <p class="body">
            Cap GitHub-hosted at a share of the minutes your plan includes. Once you reach it, jobs
            go to the next runner instead of your bill.
          </p>
        </div>
      </section>

      <!-- Bring your own -->
      <section class="section wrap feature">
        <div class="feature-copy">
          <p class="kicker">Bring your own</p>
          <h2>Your machines take jobs <span class="hl">while they're on.</span></h2>
          <p class="body">
            Run <code>relayrunner connect</code> and each job gets a fresh one-job runner. Close the
            laptop and the next job goes elsewhere. Share a machine with your team or keep it to
            yourself, and add runners your org already has.
          </p>
        </div>
        <div class="panel machines" aria-hidden="true">
          <div class="machine">
            <b
              ><img src="/providers/machines.svg" alt="" width="24" height="24" />Zach's MacBook
              Pro</b
            >
            <code>macOS · ARM64 · 12 cores · 36 GB</code>
            <div class="machine-foot">
              <span>Zach · shared with team</span><span><i class="dot go-dot"></i>online</span>
            </div>
          </div>
          <div class="machine">
            <b><img src="/providers/machines.svg" alt="" width="24" height="24" />build-mini</b>
            <code>macOS · ARM64 · 10 cores · 32 GB</code>
            <div class="machine-foot">
              <span>Atticus · private</span><span><i class="dot run-dot"></i>paused</span>
            </div>
          </div>
        </div>
      </section>

      <!-- See -->
      <section class="section wrap feature feature-flip">
        <div class="panel" aria-hidden="true">
          <div class="times">
            <div class="times-row times-head">
              <span>Job</span>
              <span
                ><img src="/providers/machines.svg" alt="" width="20" height="20" />Machine</span
              >
              <span
                ><img
                  src="/providers/blacksmith.svg"
                  alt=""
                  width="20"
                  height="20"
                />Blacksmith</span
              >
              <span><img src="/providers/github.svg" alt="" width="20" height="20" />GitHub</span>
            </div>
            <div class="times-row">
              <b>ci / test</b><code>1m 52s</code><code>2m 10s</code><code>3m 41s</code>
            </div>
            <div class="times-row">
              <b>ci / typecheck</b><code>0m 48s</code><code>1m 05s</code><code>1m 24s</code>
            </div>
            <div class="times-row">
              <b>ci / build</b><code>2m 30s</code><code>2m 02s</code><code>4m 12s</code>
            </div>
          </div>
        </div>
        <div class="feature-copy">
          <p class="kicker">See</p>
          <h2>Compare providers <span class="hl">on your own jobs.</span></h2>
          <p class="body">
            Every job shows where it ran and why. Job times compare runners side by side, and each
            provider has a page with your usage.
          </p>
        </div>
      </section>

      <!-- Free checks -->
      <section class="section wrap feature" id="checks">
        <div class="feature-copy">
          <p class="kicker">Free checks</p>
          <h2>Some checks <span class="hl">need no runner.</span></h2>
          <p class="body">
            PR title and lint checks (oxlint, ruff, actionlint and more) run inside relayrunner and
            post results to your pull request. No runner, no billed minute.
          </p>
        </div>
        <div class="panel" aria-hidden="true">
          <ul class="checks">
            <li>
              <i class="dot go-dot"></i><b>PR title</b><span>feat(api): add provider pages</span
              ><code>0 min billed</code>
            </li>
            <li>
              <i class="dot go-dot"></i><b>oxlint</b><span>0 new findings</span
              ><code>0 min billed</code>
            </li>
            <li>
              <i class="dot run-dot"></i><b>actionlint</b><span>1 finding</span
              ><code>0 min billed</code>
            </li>
          </ul>
        </div>
      </section>

      <!-- Safety -->
      <section class="section wrap" id="safety" aria-labelledby="safety-h">
        <p class="kicker">Safe by default</p>
        <h2 id="safety-h">Fallbacks first. <span class="hl">No surprises.</span></h2>
        <ul class="safety-grid">
          <li>
            <h3>Hosted stays the fallback</h3>
            <p>Machines add capacity. A closed laptop never blocks a job.</p>
          </li>
          <li>
            <h3>Public repos skip your machines</h3>
            <p>Pull requests from strangers never run on your computer.</p>
          </li>
          <li>
            <h3>Shared machines respect access</h3>
            <p>A shared machine only takes jobs from repos its owner can read.</p>
          </li>
          <li>
            <h3>Fail fast, say why</h3>
            <p>When nothing fits, the job fails with the reason instead of queuing.</p>
          </li>
        </ul>
      </section>

      <!-- Close -->
      <section class="section wrap" id="start" aria-labelledby="start-h">
        <div class="close">
          <div class="close-copy">
            <h2 id="start-h">Put every runner to work.</h2>
            <p>
              Run this in the repo you want to route. It puts a relay in front of the jobs you pick,
              keeps their old runner as the fallback, and never commits.
            </p>
            <div class="instruction">
              <code><span class="mute" aria-hidden="true">$ </span>npx relayrunner init</code>
              <button class="copy-btn" type="button" data-copy="npx relayrunner init">
                <span data-copy-label>Copy</span>
              </button>
            </div>
            <p class="close-note">
              Works with orgs and personal accounts. macOS or Linux for your own machines.
            </p>
          </div>
          <img
            class="close-mascot"
            src="/mascot.webp"
            alt=""
            width="240"
            height="317"
            loading="lazy"
          />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <a class="brand brand-sm" href="#top">
          <img class="brand-tile" src="/mascot-tile.webp" alt="" width="24" height="24" />
          relayrunner
        </a>
        <ul>
          <li><a href="/docs/">Docs</a></li>
          <li><a href="https://github.com/relayrunner/relayrunner">GitHub</a></li>
          <li><a href="https://www.npmjs.com/package/relayrunner">npm</a></li>
          <li>
            <a href="https://github.com/relayrunner/relayrunner/blob/main/docs/agent-install.md"
              >Agent setup</a
            >
          </li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
        </ul>
      </div>
    </footer>

    <p class="visually-hidden" aria-live="polite" data-announce></p>
    <script>
      import "../main.ts";
    </script>
  </body>
</html>
