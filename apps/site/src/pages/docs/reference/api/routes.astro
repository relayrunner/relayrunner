---
/*
 * The interactive API reference at /docs/reference/api/routes: Scalar renders /openapi.json
 * (src/lib/openapi.ts) inside the docs layout, in the site's colors and fonts. Client render mode
 * so it mounts after the docs' client-side navigation, not only on a full page load.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ScalarComponent } from "@scalar/astro";
---

<StarlightPage
  frontmatter={{
    title: "API routes",
    description: "Every route in the RelayRunner API, with its parameters and responses.",
    template: "splash",
  }}
>
  <ScalarComponent
    renderMode="client"
    configuration={{
      url: "/openapi.json",
      // Pinned so a new Scalar release can't change the page under us.
      cdn: "https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.78.1",
      theme: "none",
      withDefaultFonts: false,
      hideDarkModeToggle: true,
      hideClientButton: true,
      showDeveloperTools: "never",
      agent: { disabled: true },
      mcp: { disabled: true },
      telemetry: false,
    }}
  />
</StarlightPage>

<script is:inline>
  // Scalar picks light or dark from a class on <body>; follow the site's theme toggle instead.
  (() => {
    const sync = () => {
      const dark = document.documentElement.dataset.theme === "dark";
      document.body.classList.toggle("dark-mode", dark);
      document.body.classList.toggle("light-mode", !dark);
    };
    sync();
    new MutationObserver(sync).observe(document.documentElement, { attributeFilter: ["data-theme"] });
    new MutationObserver(() => {
      const dark = document.documentElement.dataset.theme === "dark";
      if (document.body.classList.contains("dark-mode") !== dark) sync();
    }).observe(document.body, { attributeFilter: ["class"] });
  })();
</script>

<style is:global>
  /* theme: "none" leaves Scalar's colors to us: map them onto the site's tokens (tokens.css). */
  .scalar-app {
    --scalar-font: var(--sans);
    --scalar-font-code: var(--mono);
    --scalar-background-1: var(--bg);
    --scalar-background-2: var(--bg-soft);
    --scalar-background-3: var(--line-soft);
    --scalar-background-accent: var(--go-soft);
    --scalar-color-1: var(--ink);
    --scalar-color-2: var(--ink-2);
    --scalar-color-3: var(--mute);
    --scalar-color-accent: var(--go-text);
    --scalar-border-color: var(--line);
    --scalar-color-green: var(--go-text);
    --scalar-button-1: var(--ink);
    --scalar-button-1-color: var(--bg);
    --scalar-button-1-hover: var(--ink-2);
  }
</style>
