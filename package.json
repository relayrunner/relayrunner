{
  "name": "relayrunner-workspace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.28.9",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.91.0",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "relayrunner": "cargo run --quiet --manifest-path apps/cli/Cargo.toml --",
    "setup:worktree": "pnpm install --frozen-lockfile",
    "typecheck": "tsc --noEmit && pnpm --filter @relayrunner/api typecheck && pnpm --filter @relayrunner/webhooks typecheck && pnpm --filter @relayrunner/agents typecheck && pnpm --filter @relayrunner/web typecheck && pnpm --filter @relayrunner/site typecheck",
    "lint": "oxlint --deny-warnings apps packages tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "prepare": "husky",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "test:watch": "vitest watch",
    "deploy:webhooks": "pnpm --filter @relayrunner/webhooks run deploy",
    "deploy:agents": "pnpm --filter @relayrunner/agents run deploy",
    "deploy:api": "pnpm --filter @relayrunner/api run deploy",
    "deploy:web": "pnpm --filter @relayrunner/web run deploy",
    "deploy:site": "pnpm --filter @relayrunner/site run deploy",
    "deploy:site:preview": "pnpm --filter @relayrunner/site run deploy:preview",
    "release:mac": "apps/mac/scripts/release-worktree.sh",
    "release:mac:dry-run": "apps/mac/scripts/release-worktree.sh --dry-run",
    "screenshots": "node scripts/screenshots.mjs",
    "changeset": "changeset",
    "changeset:lint": "node scripts/changeset-lint.mjs",
    "changeset:version": "changeset version && oxfmt apps/cli/package.json apps/cli/CHANGELOG.md apps/mac/package.json apps/mac/CHANGELOG.md --no-error-on-unmatched-pattern"
  },
  "type": "module",
  "skills": [
    "cloudflare/security-audit-skill@security-audit"
  ]
}
