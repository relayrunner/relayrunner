{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.mts",
    "apps/**/*.cts",
    "packages/**/*.ts",
    "packages/**/*.mts",
    "packages/**/*.cts",
    "tests/**/*.ts",
    "tests/**/*.mts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "apps/agents",
    "apps/docs",
    "apps/api",
    "apps/web",
    "apps/webhooks"
  ]
}
