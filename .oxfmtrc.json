{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    ".wrangler",
    "**/*.d.ts",
    "**/*.gen.ts",
    "pnpm-lock.yaml",
    "apps/api/migrations/meta",
    "apps/site/.impeccable",
    ".agents",
    ".claude/skills/security-audit"
  ]
}
